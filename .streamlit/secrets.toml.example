# Энэ файлыг secrets.toml нэрээр хуулж, утгуудаа оруулна (secrets.toml git-д орохгүй).
# Streamlit Community Cloud дээр: App settings → Secrets хэсэгт ижил агуулгаар оруулна.

# LLM: "gemini" эсвэл "anthropic" (хоосон бол байгаа түлхүүрээр сонгоно)
LLM_PROVIDER = "gemini"
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-3.1-flash-lite"
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-sonnet-5-5"

# Postgres (Neon г.м.) — байхгүй бол data/servicedesk.db SQLite файлд хадгална
DATABASE_URL = ""

# Telegram мэдэгдэл (заавал биш)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""

# Тикет засах, kill switch-д шаардана
ADMIN_PASSWORD = ""
